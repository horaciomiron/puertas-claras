# Variables del backend (copiar a .env; NO subir .env a GitHub)
PORT=3001
# Orígenes permitidos (CORS), separados por coma. Ej: https://mi-app.vercel.app
ALLOWED_ORIGINS=*
# Credenciales PROVISORIAS de demostración (cambiarlas en el hosting)
STAFF_USER=operador.demo
STAFF_PASSWORD=demo-2026

# Clara, asistente de ayuda (opcional). Sin clave usa explicaciones ya escritas.
# La clave se carga SOLO en el hosting (Render), nunca en GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
